flowchart TD
  subgraph SRC["Sources"]
    direction LR
    S1["YC Algolia<br/>batch facets"]
    S2["arXiv windows<br/>HF + GitHub"]
    S3["Product Hunt<br/>+ TAAFT"]
    S4["Job boards<br/>ATS + RSS"]
